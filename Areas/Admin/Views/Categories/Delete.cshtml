@model _25DH110874_MyStore.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XOÁ DANH MỤC</h2>

<h3 class="bg-danger">Are you sure you want to delete this?</h3>
<div class="form-group">

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="control-label col-md-2">
            @*Html.DisplayNameFor(model => model.CategoryName)*@
            Tên danh mục
        </div>
        <div class="col-md-10">
            @Html.DisplayFor(model => model.CategoryName)
        </div>

        <hr />
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Xoá" class="btn btn-primary" /> |
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    }
</div>
